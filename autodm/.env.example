# Copy to .env (never commit the real one) or set these in your hosting dashboard.

# Any secret string you choose; paste the same value in the Meta webhook settings.
VERIFY_TOKEN=change-me
# Meta App Dashboard -> App settings -> Basic -> App secret
APP_SECRET=
# Long-lived Instagram User access token (instagram_business_basic,
# instagram_business_manage_comments, instagram_business_manage_messages)
IG_ACCESS_TOKEN=
# Your Instagram professional account ID
IG_USER_ID=

# Comma-separated trigger words (case-insensitive). Match reel/reel_config.json "keyword".
DM_KEYWORDS=link
# {username} gets replaced with the commenter's username.
DM_MESSAGE=Hi {username}! Ye raha aapka free guide: https://example.com
# Leave empty to skip the public comment reply.
PUBLIC_REPLY=Check your DM {username} 📩
# Optional: only respond on these post/reel media IDs (comma-separated). Empty = all posts.
MEDIA_IDS=
